{
  "name": "clinic-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pkg install": "pnpm install",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "bump:patch": "pnpm version patch",
    "bump:minor": "pnpm version minor",
    "bump:major": "pnpm version major",
    "test": "pnpm test:unit && pnpm test:components",
    "test:coverage": "node --import ./tests/setup.js --experimental-test-coverage --test --test-isolation=none --test-coverage-include=\"src/**/*.js\" tests/*.test.js",
    "test:unit": "node --import ./tests/setup.js --test --test-isolation=none tests/*.test.js",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@tanstack/vue-query": "^5.59.0",
    "@vueuse/core": "^11.1.0",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "flatpickr": "^4.6.13",
    "libphonenumber-js": "^1.11.20",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "yup": "^1.4.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.6",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "pnpm": {
    "allowScripts": {
      "vue-demi@0.14.10": true
    }
  }
}
