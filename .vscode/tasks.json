{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clinic: build frontend",
      "type": "process",
      "command": "pnpm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "linux": {
        "command": "/usr/bin/bash",
        "args": ["-i", "-c", "pnpm run build"]
      },
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "pnpm run build"]
      }
    }
  ]
}
